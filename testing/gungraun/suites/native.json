{
  "build": [
    [
      "clang++",
      "-std=c++17",
      "-O2",
      "-g",
      "-DNDEBUG",
      "-I",
      "{source}",
      "{harness}/vector.cc",
      "-o",
      "{build}/vector"
    ],
    [
      "clang++",
      "-std=c++17",
      "-O2",
      "-g",
      "-DNDEBUG",
      "-DLYNX_GUNGRAUN_REFERENCE",
      "-I",
      "{source}",
      "{harness}/vector.cc",
      "-o",
      "{build}/reference"
    ],
    [
      "python3",
      "{harness}/build_native.py",
      "{source}",
      "{harness}",
      "{build}"
    ]
  ],
  "cases": [
    {
      "id": "push",
      "binary": "{build}/vector",
      "args": [
        "push"
      ],
      "reference": [
        "{build}/reference",
        "push"
      ]
    },
    {
      "id": "reserve",
      "binary": "{build}/vector",
      "args": [
        "reserve"
      ],
      "reference": [
        "{build}/reference",
        "reserve"
      ]
    },
    {
      "id": "erase",
      "binary": "{build}/vector",
      "args": [
        "erase"
      ],
      "reference": [
        "{build}/reference",
        "erase"
      ]
    },
    {
      "id": "layout_flex",
      "binary": "{build}/gungraun_layout",
      "args": [
        "--benchmark_filter=^BM_Layout/Flex$",
        "--benchmark_min_time=0",
        "--benchmark_repetitions=1"
      ],
      "expected_stdout": "ok",
      "instrumented": true
    },
    {
      "id": "layout_grid",
      "binary": "{build}/gungraun_layout",
      "args": [
        "--benchmark_filter=^BM_Layout/Grid$",
        "--benchmark_min_time=0",
